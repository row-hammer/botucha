[Unit]
Description=Botucha Telegram bot
# Ollama and the network are system units, which a user unit cannot wait for. The bot copes instead:
# no Telegram at start = it exits and is restarted every 10 s; no Ollama = replies wait, vision is
# rechecked every 5 minutes.

[Service]
Type=simple
WorkingDirectory=%h/Projects/botucha
ExecStart=%h/.local/share/mise/installs/uv/latest/.mise-bins/uv run python -m botucha --config config.toml
Restart=on-failure
UMask=0077
RestartSec=10
# a reply being generated gets 60 s to go out before the bot stops
TimeoutStopSec=75

[Install]
WantedBy=default.target
